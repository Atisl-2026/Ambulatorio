# Copia in .env (o imposta come variabili d'ambiente del server)
PORT=3000
DATA_DIR=./data
TZ=Europe/Rome

# Primo avvio: account del Capo (se ADMIN_PASSWORD manca, ne viene generata una e stampata nel log)
ADMIN_USERNAME=capo
ADMIN_NAME=Il Capo
ADMIN_PASSWORD=

# HTTPS: o certificati diretti...
TLS_CERT_FILE=
TLS_KEY_FILE=
# ...oppure dietro un reverse proxy che termina TLS (nginx, Caddy, Render, Railway…)
TRUST_PROXY=true
FORCE_HTTPS=true
COOKIE_SECURE=true

# Sessioni
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# Allegati
MAX_UPLOAD_MB=15

# Intelligenza artificiale (usata solo se il Capo attiva l'interruttore "IA attiva")
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Invio mensile del calendario per email (casella di posta dell'ufficio)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MONTHLY_EMAIL_HOUR=7
MAX_BACKUP_MB=500
